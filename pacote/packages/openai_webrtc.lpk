<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="openai_webrtc"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Marcelo Maurin Martins"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\AI Communication\AIWebRTC"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="Lazarus AI Suite: native WebRTC PeerConnection and DataChannel integration using libdatachannel."/>
    <License Value="OPEN SOURCE GPL3"/>
    <Files>
      <Item>
        <Filename Value="..\AI Communication\AIWebRTC\aiwebrtc_libdatachannel.pas"/>
        <UnitName Value="aiwebrtc_libdatachannel"/>
      </Item>
      <Item>
        <Filename Value="..\AI Communication\AIWebRTC\aiwebrtc_client.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="aiwebrtc_client"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item><PackageName Value="openai_core"/></Item>
      <Item><PackageName Value="LCL"/></Item>
      <Item><PackageName Value="FCL"/></Item>
    </RequiredPkgs>
    <UsageOptions><UnitPath Value="$(PkgOutDir)"/></UsageOptions>
  </Package>
</CONFIG>
