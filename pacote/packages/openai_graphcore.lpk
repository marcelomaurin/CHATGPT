<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="openai_graphcore"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Marcelo Maurin Martins"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\AI Graph Core"/>
        <UnitOutputDirectory Value="lib\openai_graphcore\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="Lazarus AI Suite: lightweight factual and inferred dependency graph core."/>
    <License Value="OPEN SOURCE GPL3"/>
    <Files Count="1">
      <Item1>
        <Filename Value="..\AI Graph Core\aidependencygraph.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="aidependencygraph"/>
      </Item1>
    </Files>
    <RequiredPkgs Count="3">
      <Item1><PackageName Value="openai_core"/></Item1>
      <Item2><PackageName Value="LCL"/></Item2>
      <Item3><PackageName Value="FCL"/></Item3>
    </RequiredPkgs>
    <UsageOptions><UnitPath Value="$(PkgOutDir)"/></UsageOptions>
    <PublishOptions><Version Value="2"/><UseFileFilters Value="True"/></PublishOptions>
  </Package>
</CONFIG>
