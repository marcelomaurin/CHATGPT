<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="openai_agentcore"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Marcelo Maurin Martins"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\AI Agent Core;.."/>
        <UnitOutputDirectory Value="lib\openai_agentcore\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="Lazarus AI Suite: lightweight agent contracts, memory, classification, decisions, actions and orchestration."/>
    <License Value="OPEN SOURCE GPL3"/>
    <Files>
      <Item>
        <Filename Value="..\AI Agent Core\aiagent_flowevents.pas"/>
        <UnitName Value="aiagent_flowevents"/>
      </Item>
      <Item>
        <Filename Value="..\AI Agent Core\aiagent_memorymap.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="aiagent_memorymap"/>
      </Item>
      <Item>
        <Filename Value="..\AI Agent Core\aiagent_core.pas"/>
        <UnitName Value="aiagent_core"/>
      </Item>
      <Item>
        <Filename Value="..\AI Agent Core\aiagent_classifier.pas"/>
        <UnitName Value="aiagent_classifier"/>
      </Item>
      <Item>
        <Filename Value="..\AI Agent Core\aiagent_decision.pas"/>
        <UnitName Value="aiagent_decision"/>
      </Item>
      <Item>
        <Filename Value="..\AI Agent Core\aiagent_actionbuilder.pas"/>
        <UnitName Value="aiagent_actionbuilder"/>
      </Item>
      <Item>
        <Filename Value="..\AI Agent Core\aiagent_actions.pas"/>
        <UnitName Value="aiagent_actions"/>
      </Item>
      <Item>
        <Filename Value="..\AI Agent Core\aiagent_executor.pas"/>
        <UnitName Value="aiagent_executor"/>
      </Item>
      <Item>
        <Filename Value="..\AI Agent Core\aiagent_orchestrator.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="aiagent_orchestrator"/>
      </Item>
      <Item>
        <Filename Value="..\AI Agent Core\aiagentsafety.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="aiagentsafety"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="openai_core"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
