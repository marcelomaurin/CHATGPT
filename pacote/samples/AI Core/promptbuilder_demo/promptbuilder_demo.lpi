<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12" />
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False" />
        <MainUnitHasTitleStatement Value="False" />
        <MainUnitHasScaledStatement Value="False" />
      </Flags>
      <SessionStorage Value="InProjectDir" />
      <Title Value="Construção de prompts a partir de componentes" />
      <UseAppBundle Value="False" />
    </General>
    <BuildModes>
      <Item Name="Default" Default="True" />
    </BuildModes>
    <RequiredPackages>
      <Item>
        <PackageName Value="openai_core" />
      </Item>
      <Item>
        <PackageName Value="LCL" />
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="promptbuilder_demo.lpr" />
        <IsPartOfProject Value="True" />
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11" />
    <Target>
      <Filename Value="promptbuilder_demo" />
    </Target>
    <SearchPaths>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)" />
      <OtherUnitFiles Value="../../../AI;../../../AI Agent;../../../AI Graph;../../../AI Output;../../../AI Project;../../../AI Math;../../../AI Input/AIInput;../../../AI Industrial;../../../AI Voice" />
    </SearchPaths>
    <Linking>
      <Options>
        <Win32GraphicApp Value="False" />
      </Options>
    </Linking>
  </CompilerOptions>
</CONFIG>
