object frmMain: TfrmMain
  Left = 200
  Height = 650
  Top = 120
  Width = 950
  Caption = 'Demonstração de Reconhecimento Facial e Identidade (YOLO Landmarks)'
  ClientHeight = 650
  ClientWidth = 950
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  LCLVersion = '3.0.0.3'
  object pnlLeft: TPanel
    Left = 0
    Height = 650
    Top = 0
    Width = 440
    Align = alLeft
    BevelOuter = bvNone
    ClientHeight = 650
    ClientWidth = 440
    TabOrder = 0
    object grpEnrollment: TGroupBox
      Left = 10
      Height = 220
      Top = 10
      Width = 420
      Caption = '1. Cadastro de Perfil de Referência'
      ClientHeight = 200
      ClientWidth = 416
      TabOrder = 0
      object lblName: TLabel
        Left = 10
        Height = 15
        Top = 10
        Width = 36
        Caption = 'Nome:'
        ParentColor = False
      end
      object edtName: TEdit
        Left = 70
        Height = 23
        Top = 8
        Width = 330
        TabOrder = 0
        Text = 'Marcelo Maurin Martins'
      end
      object lblRole: TLabel
        Left = 10
        Height = 15
        Top = 40
        Width = 35
        Caption = 'Cargo:'
        ParentColor = False
      end
      object edtRole: TEdit
        Left = 70
        Height = 23
        Top = 38
        Width = 330
        TabOrder = 1
        Text = 'Engenheiro de IA'
      end
      object btnSelectRef: TButton
        Left = 10
        Height = 30
        Top = 75
        Width = 190
        Caption = 'Selecionar Foto Referência...'
        TabOrder = 2
        OnClick = btnSelectRefClick
      end
      object lblRefFile: TLabel
        Left = 10
        Height = 15
        Top = 115
        Width = 108
        Caption = 'Nenhum arquivo sel.'
        ParentColor = False
      end
      object btnRegister: TButton
        Left = 10
        Height = 35
        Top = 150
        Width = 390
        Caption = 'Cadastrar Perfil no Registry'
        TabOrder = 3
        OnClick = btnRegisterClick
      end
    end
    object grpRecognition: TGroupBox
      Left = 10
      Height = 160
      Top = 240
      Width = 420
      Caption = '2. Consulta / Reconhecimento'
      ClientHeight = 140
      ClientWidth = 416
      TabOrder = 1
      object btnSelectQuery: TButton
        Left = 10
        Height = 30
        Top = 15
        Width = 190
        Caption = 'Selecionar Imagem Consulta...'
        TabOrder = 0
        OnClick = btnSelectQueryClick
      end
      object lblQueryFile: TLabel
        Left = 10
        Height = 15
        Top = 55
        Width = 108
        Caption = 'Nenhum arquivo sel.'
        ParentColor = False
      end
      object btnRecognize: TButton
        Left = 10
        Height = 40
        Top = 85
        Width = 390
        Caption = 'Executar Reconhecimento Facial'
        TabOrder = 1
        OnClick = btnRecognizeClick
      end
    end
    object grpConfig: TGroupBox
      Left = 10
      Height = 210
      Top = 410
      Width = 420
      Caption = '3. Configurações de Matching e Detector'
      ClientHeight = 190
      ClientWidth = 416
      TabOrder = 2
      object lblModel: TLabel
        Left = 10
        Height = 15
        Top = 10
        Width = 73
        Caption = 'Modelo YOLO:'
        ParentColor = False
      end
      object edtModel: TEdit
        Left = 90
        Height = 23
        Top = 8
        Width = 310
        TabOrder = 0
        Text = 'yolov8n-face.pt'
      end
      object lblThreshold: TLabel
        Left = 10
        Height = 15
        Top = 45
        Width = 90
        Caption = 'Match Threshold:'
        ParentColor = False
      end
      object edtThreshold: TEdit
        Left = 120
        Height = 23
        Top = 42
        Width = 80
        TabOrder = 1
        Text = '0.82'
      end
      object lblMargin: TLabel
        Left = 210
        Height = 15
        Top = 45
        Width = 99
        Caption = 'Ambiguity Margin:'
        ParentColor = False
      end
      object edtMargin: TEdit
        Left = 320
        Height = 23
        Top = 42
        Width = 80
        TabOrder = 2
        Text = '0.05'
      end
      object chkDebug: TCheckBox
        Left = 10
        Height = 19
        Top = 80
        Width = 145
        Caption = 'Ativar Debug Logging'
        TabOrder = 3
      end
      object lblTotalProfiles: TLabel
        Left = 10
        Height = 15
        Top = 120
        Width = 148
        Caption = 'Perfis Cadastrados no Registry: 0'
        Font.Style = [fsBold]
        ParentColor = False
        ParentFont = False
      end
    end
  end
  object pnlRight: TPanel
    Left = 440
    Height = 650
    Top = 0
    Width = 510
    Align = alClient
    BevelOuter = bvNone
    ClientHeight = 650
    ClientWidth = 510
    TabOrder = 1
    object grpOutput: TGroupBox
      Left = 10
      Height = 630
      Top = 10
      Width = 490
      Align = alClient
      Caption = 'Etapas do Pipeline e Diagnóstico'
      ClientHeight = 610
      ClientWidth = 486
      TabOrder = 0
      object memLog: TMemo
        Left = 5
        Height = 600
        Top = 5
        Width = 476
        Align = alClient
        Font.CharSet = ANSI_CHARSET
        Font.Name = 'Consolas'
        Font.Pitch = fpFixed
        Font.Quality = fqDraft
        ParentFont = False
        ReadOnly = True
        ScrollBars = ssAutoBoth
        TabOrder = 0
      end
    end
  end
  object OpenPictureDialog1: TOpenDialog
    Title = 'Selecionar Imagem'
    Filter = 'Imagens (*.jpg;*.jpeg;*.png;*.bmp)|*.jpg;*.jpeg;*.png;*.bmp|Todos os arquivos (*.*)|*.*'
    Left = 320
    Top = 300
  end
end
