object frmMain: TfrmMain
  Left = 200
  Height = 720
  Top = 80
  Width = 900
  Caption = 'Câmera — Vídeo ao vivo'
  ClientHeight = 720
  ClientWidth = 900
  Constraints.MinHeight = 560
  Constraints.MinWidth = 780
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  Position = poScreenCenter
  object pnlTop: TPanel
    Left = 0
    Height = 176
    Top = 0
    Width = 900
    Align = alTop
    BevelOuter = bvNone
    TabOrder = 0
    object lblTitle: TLabel
      Left = 16
      Top = 12
      Caption = 'Vídeo ao vivo'
      Font.Height = -22
      Font.Style = [fsBold]
      ParentFont = False
    end
    object lblCamera: TLabel
      Left = 16
      Top = 51
      Caption = 'Câmera'
    end
    object cmbCamera: TComboBox
      Left = 16
      Top = 72
      Width = 460
      Height = 28
      Style = csDropDownList
      OnChange = cmbCameraChange
      TabOrder = 0
    end
    object btnRefresh: TButton
      Left = 488
      Top = 70
      Width = 112
      Height = 32
      Caption = 'Atualizar'
      OnClick = btnRefreshClick
      TabOrder = 1
    end
    object btnRun: TButton
      Left = 612
      Top = 70
      Width = 140
      Height = 32
      Caption = 'Iniciar vídeo'
      OnClick = btnRunClick
      TabOrder = 2
    end
    object lblStatus: TLabel
      Left = 16
      Top = 116
      Width = 860
      Height = 20
      AutoSize = False
      Caption = 'Procurando câmeras...'
    end
    object lblResolution: TLabel
      Left = 16
      Top = 144
      Width = 860
      Height = 20
      AutoSize = False
      Caption = 'Resolução: será informada ao iniciar o vídeo'
    end
  end
  object pnlPreview: TPanel
    Left = 16
    Top = 176
    Width = 868
    Height = 420
    Align = alClient
    BorderSpacing.Left = 16
    BorderSpacing.Right = 16
    BorderSpacing.Bottom = 12
    BevelOuter = bvNone
    Caption = ''
    Color = clBlack
    ParentColor = False
    OnResize = pnlPreviewResize
    TabOrder = 1
  end
  object memoLog: TMemo
    Left = 16
    Height = 96
    Top = 608
    Width = 868
    Align = alBottom
    BorderSpacing.Left = 16
    BorderSpacing.Right = 16
    BorderSpacing.Bottom = 16
    ReadOnly = True
    ScrollBars = ssAutoVertical
    TabOrder = 2
  end
end
