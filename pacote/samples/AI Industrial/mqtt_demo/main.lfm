  object AIMQTTClient1: TAIMQTTClient
    Prompt = 'Component TAIMQTTClient is an IoT MQTT client. Properties: Host: string (MQTT broker address), Port: Integer (default 1883), ClientID: string, KeepAlive: Integer, Active: Boolean (triggers background listener thread connection), OnMessageReceived: TMQTTMessageEvent, OnConnected/OnDisconnected: TNotifyEvent. Methods: ConnectBroker, DisconnectBroker, Subscribe(const ATopic: string): Boolean, Publish(const ATopic, APayload: string): Boolean. AI Agent: Use this to publish telemetry or receive commands via MQTT brokers in IoT setups.'
    OnLog = AIMQTTClient1Log
    Host = 'broker.hivemq.com'
    ClientID = 'LazarusAI_Client'
    OnMessageReceived = OnMQTTMessageReceived
    OnConnected = OnMQTTConnected
    OnDisconnected = OnMQTTDisconnected
    Left = 890
    Top = 30
  end
