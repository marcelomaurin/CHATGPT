      Font.Height = -16
      Font.Style = [fsBold]
      ParentFont = False
    end
    object lblSubtitle: TLabel
      Left = 16
      Height = 15
      Top = 35
      Width = 580
      Caption = 'Combina busca semântica vetorial (embeddings) com busca léxica BM25 para máxima precisão de recuperação.'
      Font.Color = clGray
      ParentFont = False
    end
  end
  object pnlMain: TPanel
