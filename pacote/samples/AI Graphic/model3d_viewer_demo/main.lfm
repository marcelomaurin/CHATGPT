        ClientHeight = 180
        ClientWidth = 260
        TabOrder = 2
        object memoLog: TMemo
          Left = 8
          Height = 164
          Top = 8
          Width = 244
          Align = alClient
          BorderSpacing.Around = 8
          ReadOnly = True
          ScrollBars = ssAutoBoth
          TabOrder = 0
        end
      end
    end
    object pnlViewerHost: TPanel
      Left = 0
      Height = 570
      Top = 0
      Width = 670
      Align = alClient
      BevelOuter = bvNone
      Color = clBlack
      ParentBackground = False
      ParentColor = False
      TabOrder = 1
    end
  end
  object OpenDialog1: TOpenDialog
    Title = 'Abrir Modelo 3D'
    Filter = 'Modelos 3D (*.stl;*.obj)|*.stl;*.obj|Arquivos STL (*.stl)|*.stl|Arquivos OBJ (*.obj)|*.obj|Todos os Arquivos (*.*)|*.*'
    Left = 180
    Top = 150
  end
  object SaveDialog1: TSaveDialog
    Title = 'Exportar Imagem 3D'
    DefaultExt = '.png'
    Filter = 'Imagem PNG (*.png)|*.png|Imagem Bitmap (*.bmp)|*.bmp'
    Left = 260
    Top = 150
  end
end
