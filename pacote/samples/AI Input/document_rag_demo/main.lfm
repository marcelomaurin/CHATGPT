  object openDlg: TOpenDialog
    Title = 'Selecionar Documento para RAG'
    Filter = 'Todos os Documentos (*.pdf;*.docx;*.xlsx;*.txt)|*.pdf;*.docx;*.xlsx;*.txt|Arquivos PDF (*.pdf)|*.pdf|Arquivos DOCX (*.docx)|*.docx|Arquivos XLSX (*.xlsx)|*.xlsx|Arquivos Texto (*.txt)|*.txt'
    Left = 730
    Top = 140
