  OnDestroy = FormDestroy
  LCLVersion = '3.0.0.3'
  object pnlTop: TPanel
    Left = 0
    Height = 130
    Top = 0
    Width = 800
    Align = alTop
    ClientHeight = 130
    ClientWidth = 800
    TabOrder = 0
    object lblTitle: TLabel
      Left = 16
      Height = 22
      Top = 10
      Width = 370
      Caption = 'Integração de Documentos (PDF/DOCX/XLSX) + RAG'
      Font.Height = -16
      Font.Style = [fsBold]
      ParentColor = False
      ParentFont = False
    end
    object lblFile: TLabel
      Left = 16
      Height = 15
      Top = 48
      Width = 55
      Caption = 'Documento:'
      ParentColor = False
    end
    object edtFileName: TEdit
      Left = 78
      Height = 23
      Top = 44
      Width = 440
      TabOrder = 0
    end
    object btnBrowse: TButton
      Left = 525
      Height = 25
      Top = 43
      Width = 85
      Caption = 'Procurar...'
      OnClick = btnBrowseClick
      TabOrder = 1
