      TabOrder = 3
    end
  end
  object pnlLeft: TPanel
    Left = 0
    Height = 530
    Top = 70
    Width = 200
    Align = alLeft
    ClientHeight = 530
    ClientWidth = 200
    TabOrder = 1
    object btnGerarPrompt: TButton
      Left = 10
      Height = 35
      Top = 20
      Width = 180
      Caption = 'Gerar System Prompt'
      OnClick = btnGerarPromptClick
      TabOrder = 0
    end
  end
  object pcResults: TPageControl
    Left = 200
    Height = 530
    Top = 70
    Width = 650
    ActivePage = tsResultado
    Align = alClient
    TabIndex = 0
    TabOrder = 2
    object tsResultado: TTabSheet
      Caption = 'Resultado do Pipeline'
      ClientHeight = 502
      ClientWidth = 642
      object memResultado: TMemo
        Left = 0
        Height = 502
        Top = 0
        Width = 642
        Align = alClient
        ReadOnly = True
        ScrollBars = ssAutoBoth
        TabOrder = 0
