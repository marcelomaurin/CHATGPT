object frmPipelineProjectDemo: TfrmPipelineProjectDemo
  Left = 300
  Height = 600
  Top = 150
  Width = 850
  Caption = 'Demonstração de AI Pipeline & Project (LCL Form)'
  ClientHeight = 600
  ClientWidth = 850
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  LCLVersion = '3.4.0.0'
  object pnlTop: TPanel
    Left = 0
    Height = 70
    Top = 0
    Width = 850
    Align = alTop
    ClientHeight = 70
    ClientWidth = 850
    TabOrder = 0
    object lblProject: TLabel
      Left = 16
      Height = 15
      Top = 15
      Width = 43
      Caption = 'Projeto:'
      ParentColor = False
    end
    object edtProjectName: TEdit
      Left = 70
      Height = 23
      Top = 12
      Width = 300
      TabOrder = 0
      Text = 'MNote2 Visual Studio IDE'
    end
    object lblPrompt: TLabel
      Left = 16
      Height = 15
      Top = 42
      Width = 43
      Caption = 'Prompt:'
      ParentColor = False
    end
    object edtPrompt: TEdit
      Left = 70
      Height = 23
      Top = 39
      Width = 530
      TabOrder = 1
      Text = 'Descreva a arquitetura do projeto MNote2.'
    end
    object btnExecutarPipeline: TButton
      Left = 610
      Height = 25
      Top = 38
      Width = 110
