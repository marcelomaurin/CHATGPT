object frmMain: TfrmMain
  Left = 300
  Height = 400
  Top = 180
  Width = 720
  Caption = 'llama.cpp LoRA'
  ClientHeight = 400
  ClientWidth = 720
  OnCreate = FormCreate
  Position = poScreenCenter
  object lblModel: TLabel
    Left = 16
    Height = 15
    Top = 16
    Width = 42
    Caption = 'Modelo'
  end
  object edtModel: TEdit
    Left = 16
    Height = 28
    Top = 36
    Width = 568
    Anchors = [akTop, akLeft, akRight]
    TabOrder = 0
  end
  object btnSelectModel: TButton
    Left = 592
    Height = 28
    Top = 36
    Width = 112
    Anchors = [akTop, akRight]
    Caption = 'Selecionar...'
    OnClick = btnSelectModelClick
    TabOrder = 1
  end
  object lblAdapter: TLabel
    Left = 16
    Height = 15
    Top = 76
    Width = 58
    Caption = 'Adaptador'
  end
  object edtAdapter: TEdit
    Left = 16
    Height = 28
    Top = 96
    Width = 568
    Anchors = [akTop, akLeft, akRight]
    TabOrder = 2
  end
  object btnSelectAdapter: TButton
    Left = 592
    Height = 28
    Top = 96
    Width = 112
    Anchors = [akTop, akRight]
    Caption = 'Selecionar...'
    OnClick = btnSelectAdapterClick
    TabOrder = 3
  end
  object lblScale: TLabel
    Left = 16
    Height = 15
    Top = 136
    Width = 36
    Caption = 'Escala'
  end
  object edtScale: TEdit
    Left = 16
    Height = 28
    Top = 156
    Width = 88
    Text = '1'
    TabOrder = 4
  end
  object btnApply: TButton
    Left = 120
    Height = 28
    Top = 156
    Width = 96
    Caption = 'Aplicar'
    OnClick = btnApplyClick
    TabOrder = 5
  end
  object btnRemove: TButton
    Left = 224
    Height = 28
    Top = 156
    Width = 96
    Caption = 'Remover'
    OnClick = btnRemoveClick
    TabOrder = 6
  end
  object memLog: TMemo
    Left = 16
    Height = 188
    Top = 200
    Width = 688
    Anchors = [akTop, akLeft, akRight, akBottom]
    Font.Name = 'Consolas'
    ParentFont = False
    ReadOnly = True
    ScrollBars = ssAutoBoth
    TabOrder = 7
  end
  object LlamaRuntime: TAILlamaCppRuntime
  end
  object LlamaModel: TAILlamaCppModel
    Runtime = LlamaRuntime
  end
  object LlamaLoRA: TAILlamaCppLoRA
    Model = LlamaModel
    Scale = 1
  end
  object OpenModelDialog: TOpenDialog
    DefaultExt = '.gguf'
    Filter = 'Modelos GGUF (*.gguf)|*.gguf'
    Options = [ofFileMustExist, ofEnableSizing, ofViewDetail]
  end
  object OpenAdapterDialog: TOpenDialog
    DefaultExt = '.gguf'
    Filter = 'Adaptadores LoRA GGUF (*.gguf)|*.gguf'
    Options = [ofFileMustExist, ofEnableSizing, ofViewDetail]
  end
end
