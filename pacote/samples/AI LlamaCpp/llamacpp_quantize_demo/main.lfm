object frmMain: TfrmMain
  Left = 300
  Height = 440
  Top = 180
  Width = 760
  Caption = 'llama.cpp Quantizer'
  ClientHeight = 440
  ClientWidth = 760
  OnCreate = FormCreate
  Position = poScreenCenter
  object lblSource: TLabel
    Left = 16
    Height = 15
    Top = 16
    Width = 72
    Caption = 'GGUF origem'
  end
  object edtSource: TEdit
    Left = 16
    Height = 28
    Top = 36
    Width = 600
    Anchors = [akTop, akLeft, akRight]
    TabOrder = 0
  end
  object btnSelectSource: TButton
    Left = 624
    Height = 28
    Top = 36
    Width = 120
    Anchors = [akTop, akRight]
    Caption = 'Selecionar...'
    OnClick = btnSelectSourceClick
    TabOrder = 1
  end
  object lblDestination: TLabel
    Left = 16
    Height = 15
    Top = 76
    Width = 75
    Caption = 'GGUF destino'
  end
  object edtDestination: TEdit
    Left = 16
    Height = 28
    Top = 96
    Width = 600
    Anchors = [akTop, akLeft, akRight]
    TabOrder = 2
  end
  object btnSelectDestination: TButton
    Left = 624
    Height = 28
    Top = 96
    Width = 120
    Anchors = [akTop, akRight]
    Caption = 'Salvar como...'
    OnClick = btnSelectDestinationClick
    TabOrder = 3
  end
  object lblQuantization: TLabel
    Left = 16
    Height = 15
    Top = 136
    Width = 69
    Caption = 'Quantizacao'
  end
  object cmbQuantization: TComboBox
    Left = 16
    Height = 28
    Top = 156
    Width = 160
    Style = csDropDownList
    TabOrder = 4
  end
  object btnExecute: TButton
    Left = 192
    Height = 28
    Top = 156
    Width = 120
    Caption = 'Quantizar'
    OnClick = btnExecuteClick
    TabOrder = 5
  end
  object memLog: TMemo
    Left = 16
    Height = 228
    Top = 200
    Width = 728
    Anchors = [akTop, akLeft, akRight, akBottom]
    Font.Name = 'Consolas'
    ParentFont = False
    ReadOnly = True
    ScrollBars = ssAutoBoth
    TabOrder = 6
  end
  object LlamaRuntime: TAILlamaCppRuntime
  end
  object LlamaQuantizer: TAILlamaCppQuantizer
    Runtime = LlamaRuntime
    QuantizationType = lqtQ4_K_M
  end
  object OpenSourceDialog: TOpenDialog
    DefaultExt = '.gguf'
    Filter = 'Modelos GGUF (*.gguf)|*.gguf'
    Options = [ofFileMustExist, ofEnableSizing, ofViewDetail]
  end
  object SaveDestinationDialog: TSaveDialog
    DefaultExt = '.gguf'
    Filter = 'Modelos GGUF (*.gguf)|*.gguf'
    Options = [ofOverwritePrompt, ofEnableSizing, ofViewDetail]
  end
end
