object frmMain: TfrmMain
  Left = 300
  Height = 480
  Top = 160
  Width = 760
  Caption = 'llama.cpp + TCHATGPT'
  ClientHeight = 480
  ClientWidth = 760
  OnCreate = FormCreate
  Position = poScreenCenter
  object btnAsk: TButton
    Left = 16
    Height = 32
    Top = 16
    Width = 184
    Caption = 'Iniciar e perguntar'
    OnClick = btnAskClick
    TabOrder = 0
  end
  object memResult: TMemo
    Left = 16
    Height = 416
    Top = 56
    Width = 728
    Anchors = [akTop, akLeft, akRight, akBottom]
    Font.Name = 'Consolas'
    ParentFont = False
    ReadOnly = True
    ScrollBars = ssAutoBoth
    TabOrder = 1
  end
  object LlamaRuntime: TAILlamaCppRuntime
  end
  object LlamaModel: TAILlamaCppModel
    Runtime = LlamaRuntime
  end
  object LlamaServer: TAILlamaCppServer
    Runtime = LlamaRuntime
    Model = LlamaModel
    OnServerStarted = ServerStarted
  end
  object ChatGPT: TCHATGPT
    MaxTokens = 32
  end
  object OpenGGUFDialog: TOpenDialog
    DefaultExt = '.gguf'
    Filter = 'Modelos GGUF (*.gguf)|*.gguf'
    Options = [ofFileMustExist, ofEnableSizing, ofViewDetail]
    Title = 'Selecionar modelo GGUF'
  end
end
